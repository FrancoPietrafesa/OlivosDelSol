# Configuración SMTP para el envío de emails
# Estas variables deben configurarse en el archivo .env del servidor

# Servidor SMTP (para Gmail usar smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# Puerto SMTP (587 para TLS, 465 para SSL)
SMTP_PORT=587

# Tu email de Gmail
SMTP_USER=tu-email@gmail.com

# Contraseña de aplicación de Gmail (no tu contraseña normal)
SMTP_PASS=tu-contraseña-de-aplicación

# Email remitente (por defecto usa SMTP_USER)
FROM_EMAIL=tu-email@gmail.com

# Email donde recibir las reservas (por defecto francopietra01@gmail.com)
OWNER_EMAIL=tu-email-destino@gmail.com

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000