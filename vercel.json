{
  "version": 2,
  "builds": [
    {
      "src": "api/reservations.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/reservations",
      "dest": "api/reservations.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}